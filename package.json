  "private": true,
  "type": "module",
  "scripts": {
    "import:n8n": "node scripts/import-n8n-config.mjs",
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "scan": "tsx cli.ts scan",
    "scan:operations": "tsx cli.ts operations",
    "build:dashboard": "npm --prefix f/radar/dashboard__raw_app run build",
